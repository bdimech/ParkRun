# JS and CSS: cache for 1 hour, revalidate on each deploy
/static/*.js
  Cache-Control: public, max-age=3600

/static/*.css
  Cache-Control: public, max-age=3600

# JSON data: cache for 1 hour
/data/*
  Cache-Control: public, max-age=3600

# Never cache the HTML entry point
/
  Cache-Control: no-cache
