# JS and CSS: always revalidate against server (ETag check), re-download only if changed
/static/*.js
  Cache-Control: no-cache

/static/*.css
  Cache-Control: no-cache

# JSON data: cache for 1 hour (changes only on manual push)
/data/*
  Cache-Control: public, max-age=3600

# Never cache the HTML entry point
/
  Cache-Control: no-cache
